[
 {
  "b": 1,
  "t": "mn",
  "f": "Dế Mèn ân hận vì chuyện gì?",
  "a": "Vì tính kiêu căng, Mèn trêu chị Cốc rồi trốn vào hang — chị Cốc tưởng Choắt trêu mình nên mổ chết Choắt.",
  "fi": "../hinh-anh/nguvan/an-han-mo-de-choat.webp"
 },
 {
  "b": 1,
  "t": "mn",
  "f": "Theo cáo, \"cảm hóa\" nghĩa là gì?",
  "a": "Là tạo nên mối dây gắn bó — để hai người trở nên cần nhau và duy nhất đối với nhau.",
  "fi": "../hinh-anh/nguvan/hoang-tu-be-va-cao.webp"
 },
 {
  "b": 2,
  "t": "mn",
  "f": "Mây và sóng rủ em bé đi chơi, vì sao em bé từ chối?",
  "a": "Vì mẹ đang đợi ở nhà — ở bên mẹ là niềm vui lớn nhất, không trò chơi nào sánh bằng.",
  "fi": "../hinh-anh/nguvan/may-va-song.webp"
 },
 {
  "b": 2,
  "t": "mn",
  "f": "Đứng trước bức tranh em gái vẽ mình, người anh cảm thấy thế nào?",
  "a": "Anh sững sờ và xấu hổ — nhận ra mình đã ghen tị, nhỏ nhen trước tấm lòng trong sáng của em gái.",
  "fi": "../hinh-anh/nguvan/buc-tranh-em-gai.webp"
 },
 {
  "b": 3,
  "t": "mn",
  "f": "Mỗi lần quẹt diêm, cô bé bán diêm nhìn thấy gì?",
  "a": "Thấy những mộng tưởng ấm áp: lò sưởi, bàn ăn thịnh soạn, cây thông Nô-en — và người bà đã mất mà em yêu quý nhất.",
  "fi": "../hinh-anh/nguvan/co-be-ban-diem.webp"
 },
 {
  "b": 3,
  "t": "mn",
  "f": "Chị em Sơn đã làm gì cho bé Hiên khi gió lạnh đầu mùa về?",
  "a": "Hai chị em lấy chiếc áo bông cũ — kỉ vật của người em gái đã mất — cho Hiên mặc đỡ rét.",
  "fi": "../hinh-anh/nguvan/gio-lanh-dau-mua.webp"
 },
 {
  "b": 4,
  "t": "mn",
  "f": "Vì sao cây tre là biểu tượng của con người Việt Nam?",
  "a": "Vì tre thẳng thắn, dẻo dai, sống đoàn kết thành lũy — như phẩm chất kiên cường, đoàn kết của người Việt.",
  "fi": "../hinh-anh/nguvan/cay-tre-viet-nam.webp"
 },
 {
  "b": 4,
  "t": "mn",
  "f": "Chùm ca dao trong bài ngợi ca điều gì?",
  "a": "Ngợi ca vẻ đẹp của quê hương, đất nước — và công sức lao động của con người làm nên vẻ đẹp ấy.",
  "fi": "../hinh-anh/nguvan/que-huong-luy-tre.webp"
 },
 {
  "b": 5,
  "t": "mn",
  "f": "Bên trong Hang Én có gì đặc biệt?",
  "a": "Hang khổng lồ đến mức bên trong có cả dòng sông ngầm, bãi cát đón nắng và hàng vạn con chim én làm tổ.",
  "fi": "../hinh-anh/nguvan/hang-en.webp"
 },
 {
  "b": 5,
  "t": "mn",
  "f": "Nguyễn Tuân tả đảo Cô Tô vào thời điểm nào?",
  "a": "Ngay sau trận bão: trời quang, biển trong xanh, mặt trời mọc rực rỡ trên mặt biển như một bức tranh.",
  "fi": "../hinh-anh/nguvan/bien-dao-co-to.webp"
 },
 {
  "b": 6,
  "t": "mn",
  "f": "Gióng lớn lên thế nào khi ra trận?",
  "a": "Gióng ăn bao nhiêu cũng không no, rồi vươn vai thành tráng sĩ cao lớn, mặc giáp sắt, cưỡi ngựa sắt ra trận.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cline%20x1%3D%2250%22%20y1%3D%2286%22%20x2%3D%2250%22%20y2%3D%2252%22%20stroke%3D%22%238d6e63%22%20stroke-width%3D%226%22%20stroke-linecap%3D%22round%22%2F%3E%3Cpolygon%20points%3D%2250%2C10%2056%2C48%2044%2C48%22%20fill%3D%22%23b0bec5%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2238%22%20y1%3D%2256%22%20x2%3D%2262%22%20y2%3D%2256%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 6,
  "t": "mn",
  "f": "Vì sao gọi Sơn Tinh, Thủy Tinh là truyền thuyết?",
  "a": "Vì truyện gắn với thời Hùng Vương xa xưa và có yếu tố kì ảo: thần núi, thần biển, phép thần thông.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cpolygon%20points%3D%2214%2C84%2040%2C30%2056%2C58%2070%2C26%2088%2C84%22%20fill%3D%22%2390a4ae%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%222%22%2F%3E%3Cpolygon%20points%3D%2240%2C30%2046%2C42%2034%2C42%22%20fill%3D%22%23ffffff%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 7,
  "t": "mn",
  "f": "Giết chằn tinh, Thạch Sanh được gì?",
  "a": "Bộ cung tên vàng. Về sau, chàng còn được đàn thần và niêu cơm thần.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cline%20x1%3D%2250%22%20y1%3D%2286%22%20x2%3D%2250%22%20y2%3D%2252%22%20stroke%3D%22%238d6e63%22%20stroke-width%3D%226%22%20stroke-linecap%3D%22round%22%2F%3E%3Cpolygon%20points%3D%2250%2C10%2056%2C48%2044%2C48%22%20fill%3D%22%23b0bec5%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2238%22%20y1%3D%2256%22%20x2%3D%2262%22%20y2%3D%2256%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 7,
  "t": "mn",
  "f": "Chim thần dặn người em điều gì?",
  "a": "May túi ba gang để đựng vàng, nghĩa là chỉ lấy vừa đủ, không tham.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cellipse%20cx%3D%2248%22%20cy%3D%2252%22%20rx%3D%2226%22%20ry%3D%2217%22%20fill%3D%22%2342a5f5%22%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%2F%3E%3Ccircle%20cx%3D%2270%22%20cy%3D%2240%22%20r%3D%2211%22%20fill%3D%22%2342a5f5%22%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%2F%3E%3Cpolygon%20points%3D%2280%2C40%2092%2C44%2080%2C48%22%20fill%3D%22%23ff9800%22%2F%3E%3Cline%20x1%3D%2240%22%20y1%3D%2268%22%20x2%3D%2236%22%20y2%3D%2284%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%223%22%2F%3E%3Cline%20x1%3D%2256%22%20y1%3D%2268%22%20x2%3D%2260%22%20y2%3D%2284%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%223%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 8,
  "t": "mn",
  "f": "'So sánh' nghĩa là gì?",
  "a": "Đặt hai người, hai vật cạnh nhau để xem giống và khác nhau. Ví dụ: đừng so sánh mình với bạn để rồi buồn.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cline%20x1%3D%2250%22%20y1%3D%2214%22%20x2%3D%2250%22%20y2%3D%2252%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%224%22%2F%3E%3Cline%20x1%3D%2220%22%20y1%3D%2226%22%20x2%3D%2280%22%20y2%3D%2226%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%224%22%2F%3E%3Cpath%20d%3D%22M%2020%2C26%20Q%2020%2C52%208%2C52%20Q%2032%2C52%2020%2C26%20Z%22%20fill%3D%22none%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3Cpath%20d%3D%22M%2080%2C26%20Q%2080%2C52%2068%2C52%20Q%2092%2C52%2080%2C26%20Z%22%20fill%3D%22none%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2230%22%20y1%3D%2284%22%20x2%3D%2270%22%20y2%3D%2284%22%20stroke%3D%22%2337474f%22%20stroke-width%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 8,
  "t": "mn",
  "f": "Nói và nghe Bài 8 luyện gì?",
  "a": "Trình bày ý kiến về một hiện tượng đời sống, nói rõ ràng và nghe bạn tôn trọng.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cellipse%20cx%3D%2246%22%20cy%3D%2244%22%20rx%3D%2232%22%20ry%3D%2224%22%20fill%3D%22%23ffffff%22%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%2F%3E%3Cpolygon%20points%3D%2234%2C64%2030%2C84%2048%2C66%22%20fill%3D%22%23ffffff%22%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%2F%3E%3Cg%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%3E%3Cline%20x1%3D%2228%22%20y1%3D%2240%22%20x2%3D%2264%22%20y2%3D%2240%22%2F%3E%3Cline%20x1%3D%2228%22%20y1%3D%2250%22%20x2%3D%2256%22%20y2%3D%2250%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 9,
  "t": "mn",
  "f": "'Bảo vệ' nghĩa là gì? Đồng nghĩa là gì?",
  "a": "Bảo vệ là giữ gìn, không để bị phá hoại. Đồng nghĩa: giữ gìn. Ví dụ: 'Em bảo vệ môi trường bằng cách bỏ rác đúng nơi.'",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cpath%20d%3D%22M%2050%2C10%20L%2080%2C24%20L%2080%2C50%20Q%2080%2C74%2050%2C88%20Q%2020%2C74%2020%2C50%20L%2020%2C24%20Z%22%20fill%3D%22%2342a5f5%22%20stroke%3D%22%231565c0%22%20stroke-width%3D%222%22%2F%3E%3Cpath%20d%3D%22M%2038%2C50%20L%2048%2C60%20L%2064%2C40%22%20fill%3D%22none%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%225%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 9,
  "t": "mn",
  "f": "Vì sao phải giữ cân bằng sinh thái?",
  "a": "Vì các loài nương tựa nhau. Một loài mất đi có thể làm nhiều loài khác khổ theo.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cpath%20d%3D%22M%2050%2C8%20Q%2088%2C30%2082%2C66%20Q%2076%2C92%2050%2C92%20Q%2024%2C92%2018%2C66%20Q%2012%2C30%2050%2C8%20Z%22%20fill%3D%22%2366bb6a%22%20stroke%3D%22%232e7d32%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2250%22%20y1%3D%2214%22%20x2%3D%2250%22%20y2%3D%2288%22%20stroke%3D%22%232e7d32%22%20stroke-width%3D%222%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 10,
  "t": "mn",
  "f": "'Giới thiệu' nghĩa là gì?",
  "a": "Nói, cho người khác biết về một thứ. Ví dụ: 'Em giới thiệu cuốn sách yêu thích với cả lớp.'",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cpath%20d%3D%22M%2050%2C26%20Q%2032%2C16%2016%2C22%20L%2016%2C74%20Q%2032%2C68%2050%2C78%20Q%2068%2C68%2084%2C74%20L%2084%2C22%20Q%2068%2C16%2050%2C26%20Z%22%20fill%3D%22%23fff9c4%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2250%22%20y1%3D%2226%22%20x2%3D%2250%22%20y2%3D%2278%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 },
 {
  "b": 10,
  "t": "mn",
  "f": "Mỗi ngày một cuốn sách giúp em điều gì?",
  "a": "Đọc đều mỗi ngày thành thói quen tốt, giúp em hiểu sâu và nhớ lâu hơn.",
  "fi": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20300%20120%22%20style%3D%22width%3A100%25%3Bmax-width%3A400px%3Bheight%3Aauto%3Bdisplay%3Ablock%3Bmargin%3A0%20auto%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20transform%3D%22translate%28100%2C10%29%20scale%281.0%29%22%3E%3Cpath%20d%3D%22M%2050%2C26%20Q%2032%2C16%2016%2C22%20L%2016%2C74%20Q%2032%2C68%2050%2C78%20Q%2068%2C68%2084%2C74%20L%2084%2C22%20Q%2068%2C16%2050%2C26%20Z%22%20fill%3D%22%23fff9c4%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3Cline%20x1%3D%2250%22%20y1%3D%2226%22%20x2%3D%2250%22%20y2%3D%2278%22%20stroke%3D%22%23e65100%22%20stroke-width%3D%222%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"
 }
